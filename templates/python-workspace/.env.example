# Export these environment variables; the application does not auto-load .env files.
APP_DATABASE=.data/app.sqlite3
APP_ORIGIN=http://127.0.0.1:8000
APP_SECURE_COOKIES=false
APP_ALLOW_REGISTRATION=true
# For HTTPS deployment, set the exact public origin and APP_SECURE_COOKIES=true.
# Create operator accounts, then consider disabling public registration.
